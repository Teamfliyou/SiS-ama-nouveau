# ─── Variables utilisées par docker-compose.yml ────────────────────────
# Ce fichier est un EXEMPLE. Le vrai .env est créé sur le serveur par
# deploy/install.sh (secrets générés automatiquement, jamais commités).

# Mot de passe PostgreSQL (généré automatiquement par install.sh).
POSTGRES_PASSWORD=

# Secret de signature des JWT (généré automatiquement par install.sh).
JWT_SECRET=

# Origine autorisée pour le frontend (IP publique ou domaine du serveur).
FRONTEND_URL=http://localhost

# ─── Réglages optionnels (valeurs par défaut du backend) ──────────────
# LOGIN_RATE_MAX=5
# LOGIN_RATE_IP_MAX=20
# LOGIN_RATE_WINDOW_MS=900000
# RATE_MAX_GENERAL=300
# RATE_WINDOW_GENERAL_MS=900000