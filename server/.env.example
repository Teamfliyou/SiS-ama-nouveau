# ─── Server configuration ──────────────────────────────────────────────

# Port the API listens on.
PORT=5000

# Environment: development | test | production
NODE_ENV=development

# ─── PostgreSQL database (REQUIRED) ────────────────────────────────────
# Connection string used by Prisma. Never use a real password here —
# copy this file to `.env` and put the real credentials there.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="postgresql://sisama_user:CHANGE_ME@localhost:5432/sisama?schema=public"

# Database used by the automated test suite (vitest). Optional locally,
# but a local PostgreSQL server with this database must be running to run
# the tests (see README). In CI, set it to a dedicated test database.
# TEST_DATABASE_URL="postgresql://sisama_user:CHANGE_ME@localhost:5432/sisama_test?schema=public"

# ── REQUIRED ──────────────────────────────────────────────────────────
# Secret used to sign JWT tokens.
# The server refuses to start without it, if it is shorter than 16 characters,
# or if it still equals the placeholder below (e.g. openssl rand -base64 48).
# NEVER share this value or commit a real secret to git.
JWT_SECRET=CHANGE_ME_with_a_long_random_secret_at_least_16_chars

# Allowed frontend origin(s) in production (comma-separated).
# FRONTEND_URL and CORS_ORIGIN are both accepted and merged.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Set to true ONLY when the app runs behind a single trusted reverse proxy
# (e.g. Railway). It enables Express trust proxy so `req.ip` reflects the real
# client IP, keeping rate limiting correct. Forwarded headers are ignored by
# default to prevent spoofing.
TRUST_PROXY=false

# ── Optional tuning (defaults shown) ─────────────────────────────────
# Login brute-force protection
LOGIN_RATE_MAX=5
LOGIN_RATE_IP_MAX=20
LOGIN_RATE_WINDOW_MS=900000
# General per-IP API budget on /api
RATE_MAX_GENERAL=300
RATE_WINDOW_GENERAL_MS=900000

# ── PostgreSQL backups (see README → Sauvegardes) ────────────────────
# The pg_dump / pg_restore scripts in scripts/ read DATABASE_URL directly,
# so no extra configuration is needed here.