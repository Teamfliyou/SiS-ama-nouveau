# Server configuration
PORT=5000

# SQLite database file (relative to the prisma/ folder)
# Local dev:      file:./dev.db
# Railway volume: file:/data/prod.db (mount a Volume at /data so data persists across deploys)
DATABASE_URL="file:./dev.db"

# ── REQUIRED ──────────────────────────────────────────────────────────
# Secret used to sign JWT tokens.
# The server refuses to start without it, if it is shorter than 16 characters,
# or if it still equals the placeholder below (e.g. openssl rand -base64 48).
# NEVER share this value or commit a real secret to git.
JWT_SECRET=CHANGE_ME_with_a_long_random_secret_at_least_16_chars

# Allowed frontend origin(s) in production (comma-separated).
# FRONTEND_URL and CORS_ORIGIN are both accepted and merged.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Optional tuning (defaults shown) ─────────────────────────────────
# Login brute-force protection
LOGIN_RATE_MAX=5
LOGIN_RATE_IP_MAX=20
LOGIN_RATE_WINDOW_MS=900000
# General per-IP API budget on /api
RATE_MAX_GENERAL=300
RATE_WINDOW_GENERAL_MS=900000