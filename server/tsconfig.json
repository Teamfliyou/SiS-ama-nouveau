{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": ["index.ts", "lib/**/*.ts", "middleware/**/*.ts", "routes/**/*.ts", "test/**/*.ts", "global-setup.ts", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}
