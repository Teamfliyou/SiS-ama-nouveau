datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  STAFF
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHEQUE
  MOBILE_MONEY
  OTHER
}

model SchoolYear {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  active      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  classes     Class[]
  enrollments Enrollment[]
}

model User {
  id            Int            @id @default(autoincrement())
  email         String         @unique
  password      String
  role          UserRole       @default(STAFF)
  teacherId     Int?           @unique
  teacher       Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  announcements Announcement[]
  documents     Document[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  pinned      Boolean  @default(false)
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Document {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  category     String   @default("INFORMATION")
  fileName     String
  mimeType     String
  size         Int
  data         Bytes
  uploadedById Int?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Class {
  timetableSlots TimetableSlot[]
  lessons Lesson[]
  openForRegistration Boolean @default(false)
  scheduleLabel String?
  capacity Int?
  preRegistrationChildren PreRegistrationChild[]
  id              Int            @id @default(autoincrement())
  name            String
  tuitionFeeCents Int            @default(0)
  schoolYearId    Int?
  schoolYear      SchoolYear?    @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  students        Student[]
  attendances     Attendance[]
  teachers        Teacher[]
  teacherClasses  TeacherClass[]
  enrollments     Enrollment[]
  evaluations     Evaluation[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([name, schoolYearId])
  @@index([schoolYearId])
}

model Student {
  birthDate String?
  gender String?
  medicalInfo String?
  photoOptOut Boolean @default(false)
  canLeaveAlone Boolean @default(false)
  guardians Guardian[]
  preRegistrationChildren PreRegistrationChild[]
  id          Int          @id @default(autoincrement())
  firstName   String
  lastName    String
  phone                  String?
  dateOfBirth            DateTime? @db.Date
  wasEnrolled2025_2026   Boolean?
  arabicCourse           String?
  quranCourse            String?
  quranLevel              Int @default(1)
  quranPath               String @default("BOTTOM_UP")
  classId                Int?
  class       Class?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  familyId    Int?
  family      Family?      @relation(fields: [familyId], references: [id], onDelete: SetNull)
  payments    Payment[]
  attendances Attendance[]
  enrollments Enrollment[]
  grades        Grade[]
  surahLevels   SurahAssessment[]
  rubLevels     RubAssessment[]
  reportRemarks ReportRemark[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([lastName, firstName])
  @@index([classId])
  @@index([familyId])
}

model Payment {
  id            Int           @id @default(autoincrement())
  amountCents   Int
  // Part of the family discount credited to this student (0 for an individual payment).
  // The amount still due is tuition - amountCents - discountCents.
  discountCents Int           @default(0)
  date          DateTime      @default(now())
  studentId     Int
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  method        PaymentMethod @default(CASH)
  reference     String?
  note          String?
  // Set when the payment line belongs to a multi-child (grouped) payment.
  groupId       Int?
  group         PaymentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([studentId])
  @@index([date])
  @@index([groupId])
}

// One transaction settling several children at once. Each child keeps its own
// Payment line (linked through groupId) so balances keep working per student.
model PaymentGroup {
  id            Int            @id @default(autoincrement())
  date          DateTime       @default(now())
  method        PaymentMethod? @default(CASH)
  subtotalCents Int
  discountCents Int
  totalCents    Int
  createdById   Int?
  payments      Payment[]
}

model Teacher {
  timetableSlots TimetableSlot[]
  lessons        Lesson[]
  id             Int            @id @default(autoincrement())
  firstName      String
  lastName       String
  subject        String?
  email          String?        @unique
  phone          String?
  classId        Int?
  class          Class?         @relation(fields: [classId], references: [id])
  teacherClasses TeacherClass[]
  user           User?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([lastName, firstName])
}

model TeacherClass {
  teacherId Int
  classId   Int
  subject   String?
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([teacherId, classId])
  @@index([classId])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  date      DateTime         @db.Date
  period    String           @default("DAY")
  studentId Int
  classId   Int
  status    AttendanceStatus @default(PRESENT)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([date, period, studentId])
  @@index([classId, date])
}

model Enrollment {
  id           Int         @id @default(autoincrement())
  studentId    Int
  classId      Int
  schoolYearId Int?
  isActive     Boolean     @default(true)
  startDate    DateTime?   @db.Date
  endDate      DateTime?   @db.Date
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  @@unique([studentId, classId, schoolYearId])
  @@index([studentId])
  @@index([classId])
  @@index([isActive])
}

model Family {
  id        Int       @id @default(autoincrement())
  name      String?
  phone     String?
  email     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  students  Student[]
}

// ─── Scolarité : notes, compétences Juz Amma, bulletins ──────────────

model Subject {
  timetableSlots TimetableSlot[]
  lessons Lesson[]
  id          Int          @id @default(autoincrement())
  name        String       @unique
  coefficient Int          @default(1)
  evaluations Evaluation[]
  createdAt   DateTime     @default(now())
}

// A grading period (trimestre, semestre...). Its dates bound the attendance
// counted on the report card.
model Term {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  startDate     String // "YYYY-MM-DD"
  endDate       String // "YYYY-MM-DD"
  evaluations   Evaluation[]
  surahLevels   SurahAssessment[]
  rubLevels     RubAssessment[]
  reportRemarks ReportRemark[]
  createdAt     DateTime          @default(now())
}

// One test given to a class (e.g. "Contrôle 1"), whose marks are entered together.
model Evaluation {
  id          Int      @id @default(autoincrement())
  title       String
  date        String // "YYYY-MM-DD"
  maxScore    Int      @default(20)
  coefficient Int      @default(1)
  classId     Int
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   Int
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  termId      Int
  term        Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  grades      Grade[]
  createdAt   DateTime @default(now())

  @@index([classId, termId])
}

model Grade {
  id           Int        @id @default(autoincrement())
  // Mark in hundredths of a point (12.5/20 -> 1250), null when absent.
  scoreCents   Int?
  absent       Boolean    @default(false)
  evaluationId Int
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, studentId])
}

// Competency level reached on one surah of the Juz Amma (surahs 78 to 114) for a term.
model SurahAssessment {
  id          Int     @id @default(autoincrement())
  surahNumber Int
  level       String // NOT_ACQUIRED, IN_PROGRESS, ACQUIRED, MASTERED
  studentId   Int
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId      Int
  term        Term    @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@unique([studentId, termId, surahNumber])
}

// General appreciation written on a student's report card for a term.
model ReportRemark {
  id        Int      @id @default(autoincrement())
  comment   String
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    Int
  term      Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt

  @@unique([studentId, termId])
}

model Guardian {
  id           Int       @id @default(autoincrement())
  relationship String // Mère, Père, Tuteur...
  firstName    String
  lastName     String
  phone        String
  email        String
  address      String?
  profession   String?
  volunteer    Boolean   @default(false)
  students     Student[]
  createdAt    DateTime  @default(now())
}

model TimetableSlot {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int // 1 = lundi ... 7 = dimanche (ISO 8601)
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  label     String?
  room      String?
  classId   Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId Int?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId Int?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  lessons   Lesson[]
  createdAt DateTime @default(now())

  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
}

model Lesson {
  id              Int            @id @default(autoincrement())
  date            String // "YYYY-MM-DD"
  startTime       String? // "HH:MM"
  endTime         String? // "HH:MM"
  label           String?
  content         String?
  homework        String?
  homeworkDueDate String? // "YYYY-MM-DD", set whenever homework is
  classId         Int
  class           Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  slotId          Int?
  slot            TimetableSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  subjectId       Int?
  subject         Subject?       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId       Int?
  teacher         Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([classId, date, slotId])
  @@index([classId, date])
  @@index([homeworkDueDate])
}

model RegistrationSettings {
  id               Int      @id @default(1)
  isOpen           Boolean  @default(false)
  schoolYear       String   @default("2026-2027")
  minAge           Int      @default(4)
  ageReferenceDate String   @default("2026-10-31") // children must be minAge on this date
  contactEmail     String?
  helloAssoUrl     String?
  rulesText        String   @default("Règlement intérieur")
  updatedAt        DateTime @updatedAt
}

model PreRegistration {
  id            Int                       @id @default(autoincrement())
  reference     String                    @unique // PI-2026-0001
  status        String                    @default("NEW") // NEW, WAITLIST, VALIDATED, REFUSED
  schoolYear    String
  subtotalCents Int
  discountCents Int
  totalCents    Int
  rulesAccepted Boolean
  honorAttested Boolean
  emailStatus   String? // SENT, SIMULATED, FAILED
  emailText     String? // confirmation sent to the family, kept for the record
  adminNote     String?
  children      PreRegistrationChild[]
  guardians     PreRegistrationGuardian[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([status])
}

model PreRegistrationChild {
  id                Int             @id @default(autoincrement())
  preRegistrationId Int
  preRegistration   PreRegistration @relation(fields: [preRegistrationId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  birthDate         String // "YYYY-MM-DD"
  gender            String // "F" | "M"
  firstEnrollment   Boolean
  classId           Int?
  class             Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  feeCents          Int
  waitlisted        Boolean         @default(false) // the class was full when the file was sent
  medicalInfo       String?
  photoOptOut       Boolean         @default(false)
  canLeaveAlone     Boolean         @default(false)
  // Student created (or updated) when the file is validated.
  studentId         Int?
  student           Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([classId])
}

model PreRegistrationGuardian {
  id                Int             @id @default(autoincrement())
  preRegistrationId Int
  preRegistration   PreRegistration @relation(fields: [preRegistrationId], references: [id], onDelete: Cascade)
  relationship      String
  firstName         String
  lastName          String
  phone             String
  email             String
  address           String?
  profession        String?
  volunteer         Boolean         @default(false)
}

model RubAssessment {
  id        Int     @id @default(autoincrement())
  hizb      Int // 1 to 56
  quarter   Int // 1 to 4
  level     String // NOT_ACQUIRED, IN_PROGRESS, ACQUIRED, MASTERED
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    Int
  term      Term    @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@unique([studentId, termId, hizb, quarter])
}
