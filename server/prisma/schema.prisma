datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  STAFF
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHEQUE
  MOBILE_MONEY
  OTHER
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id              Int          @id @default(autoincrement())
  name            String       @unique
  tuitionFeeCents Int          @default(0)
  students        Student[]
  attendances     Attendance[]
  teachers        Teacher[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model Student {
  id          Int          @id @default(autoincrement())
  firstName   String
  lastName    String
  phone       String?
  classId     Int?
  class       Class?       @relation(fields: [classId], references: [id])
  payments    Payment[]
  attendances Attendance[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([lastName, firstName])
  @@index([classId])
}

model Payment {
  id          Int           @id @default(autoincrement())
  amountCents Int
  date        DateTime      @default(now())
  studentId   Int
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  method      PaymentMethod @default(CASH)
  reference   String?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([studentId])
  @@index([date])
}

model Teacher {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  subject   String?
  email     String?  @unique
  phone     String?
  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lastName, firstName])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  date      DateTime         @db.Date
  studentId Int
  classId   Int
  status    AttendanceStatus @default(PRESENT)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([date, studentId])
  @@index([classId, date])
}
