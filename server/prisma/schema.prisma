datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("STAFF")
  createdAt DateTime @default(now())
}

model Class {
  id              Int          @id @default(autoincrement())
  name            String       @unique
  tuitionFeeCents Int          @default(0)
  students        Student[]
  attendances     Attendance[]
  teachers        Teacher[]
  createdAt       DateTime     @default(now())
}

model Student {
  id          Int          @id @default(autoincrement())
  firstName   String
  lastName    String
  phone       String?
  classId     Int?
  class       Class?       @relation(fields: [classId], references: [id])
  payments    Payment[]
  attendances Attendance[]
  createdAt   DateTime     @default(now())
}

model Payment {
  id            Int           @id @default(autoincrement())
  amountCents   Int
  // Part of the family discount credited to this student (0 for an individual payment).
  // The amount still due is tuition - amountCents - discountCents.
  discountCents Int           @default(0)
  date          DateTime      @default(now())
  studentId     Int
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  method        String?       @default("Espèces")
  // Set when the payment line belongs to a multi-child (grouped) payment.
  groupId       Int?
  group         PaymentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// One transaction settling several children at once. Each child keeps its own
// Payment line (linked through groupId) so balances keep working per student.
model PaymentGroup {
  id            Int       @id @default(autoincrement())
  date          DateTime  @default(now())
  method        String?   @default("Espèces")
  subtotalCents Int
  discountCents Int
  totalCents    Int
  createdById   Int?
  payments      Payment[]
}

model Teacher {
  id        Int      @id @default(autoincrement())
  firstName String
  lastName  String
  subject   String?
  email     String?  @unique
  phone     String?
  classId   Int?
  class     Class?   @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now())
}

model Attendance {
  id        Int     @id @default(autoincrement())
  date      String  // "YYYY-MM-DD"
  studentId Int
  classId   Int
  status    String  @default("PRESENT") // PRESENT, ABSENT, LATE
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([date, studentId])
}
