datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  STAFF
  TEACHER
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  CHEQUE
  MOBILE_MONEY
  OTHER
}

model SchoolYear {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  startDate   DateTime     @db.Date
  endDate     DateTime     @db.Date
  active      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  classes     Class[]
  enrollments Enrollment[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Class {
  id               Int            @id @default(autoincrement())
  name             String         @unique
  tuitionFeeCents  Int            @default(0)
  schoolYearId     Int?
  schoolYear       SchoolYear?    @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)
  students         Student[]
  attendances      Attendance[]
  teachers         Teacher[]
  teacherClasses   TeacherClass[]
  enrollments      Enrollment[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([schoolYearId])
}

model Student {
  id          Int          @id @default(autoincrement())
  firstName   String
  lastName    String
  phone       String?
  classId     Int?
  class       Class?       @relation(fields: [classId], references: [id])
  payments    Payment[]
  attendances Attendance[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([lastName, firstName])
  @@index([classId])
}

model Payment {
  id          Int           @id @default(autoincrement())
  amountCents Int
  date        DateTime      @default(now())
  studentId   Int
  student     Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  method      PaymentMethod @default(CASH)
  reference   String?
  note        String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([studentId])
  @@index([date])
}

model Teacher {
  id             Int              @id @default(autoincrement())
  firstName      String
  lastName       String
  subject        String?
  email          String?          @unique
  phone          String?
  classId        Int?
  class          Class?           @relation(fields: [classId], references: [id])
  teacherClasses TeacherClass[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([lastName, firstName])
}

model TeacherClass {
  teacherId Int
  classId   Int
  subject   String?
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([teacherId, classId])
  @@index([classId])
}

model Attendance {
  id        Int              @id @default(autoincrement())
  date      DateTime         @db.Date
  studentId Int
  classId   Int
  status    AttendanceStatus @default(PRESENT)
  student   Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class            @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([date, studentId])
  @@index([classId, date])
}

model Enrollment {
  id           Int         @id @default(autoincrement())
  studentId    Int
  classId      Int
  schoolYearId Int?
  isActive     Boolean     @default(true)
  startDate    DateTime?   @db.Date
  endDate      DateTime?   @db.Date
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class        Class       @relation(fields: [classId], references: [id], onDelete: Cascade)
  schoolYear   SchoolYear? @relation(fields: [schoolYearId], references: [id], onDelete: SetNull)

  @@unique([studentId, classId, schoolYearId])
  @@index([studentId])
  @@index([classId])
  @@index([isActive])
}
