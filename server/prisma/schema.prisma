datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role          String         @default("STAFF")
  announcements Announcement[]
  documents     Document[]
  createdAt     DateTime       @default(now())
}

// ─── Messagerie et documents ─────────────────────────────────────────
// Published by administrators; read by the whole team for now, by the
// families later (family space).

// Information posted by the administration (Messagerie).
model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  body        String
  pinned      Boolean  @default(false) // shown first
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Important document (règlement intérieur, informations...). The file is
// stored in the database so it survives redeployments and database backups.
model Document {
  id           Int      @id @default(autoincrement())
  title        String
  description  String?
  category     String   @default("INFORMATION") // REGLEMENT, INFORMATION, AUTRE
  fileName     String
  mimeType     String
  size         Int // bytes
  data         Bytes
  uploadedById Int?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Class {
  id                      Int                    @id @default(autoincrement())
  name                    String                 @unique
  tuitionFeeCents         Int                    @default(0)
  students                Student[]
  attendances             Attendance[]
  teachers                Teacher[]
  evaluations             Evaluation[]
  timetableSlots          TimetableSlot[]
  lessons                 Lesson[]
  // Online pre-registration: whether families can choose this class, the time
  // slot shown to them ("Samedi matin") and the number of places (null = unlimited).
  openForRegistration     Boolean                @default(false)
  scheduleLabel           String?
  capacity                Int?
  preRegistrationChildren PreRegistrationChild[]
  createdAt               DateTime               @default(now())
}

model Student {
  id                      Int                    @id @default(autoincrement())
  firstName               String
  lastName                String
  phone                   String?
  birthDate               String? // "YYYY-MM-DD"
  gender                  String? // "F" | "M"
  medicalInfo             String?
  photoOptOut             Boolean                @default(false) // the family refuses photos of the child
  canLeaveAlone           Boolean                @default(false) // allowed to go home alone
  quranLevel              Int                    @default(1) // Quran programme level (1 to 11), see lib/quran.ts
  quranPath               String                 @default("BOTTOM_UP") // Dar Al Coran learning path, see lib/quran.ts
  classId                 Int?
  class                   Class?                 @relation(fields: [classId], references: [id])
  guardians               Guardian[]
  payments                Payment[]
  attendances             Attendance[]
  grades                  Grade[]
  surahLevels             SurahAssessment[]
  rubLevels               RubAssessment[]
  reportRemarks           ReportRemark[]
  preRegistrationChildren PreRegistrationChild[]
  createdAt               DateTime               @default(now())
}

// Parent or legal guardian, shared by siblings.
model Guardian {
  id           Int       @id @default(autoincrement())
  relationship String // Mère, Père, Tuteur...
  firstName    String
  lastName     String
  phone        String
  email        String
  address      String?
  profession   String?
  volunteer    Boolean   @default(false)
  students     Student[]
  createdAt    DateTime  @default(now())
}

model Payment {
  id            Int           @id @default(autoincrement())
  amountCents   Int
  // Part of the family discount credited to this student (0 for an individual payment).
  // The amount still due is tuition - amountCents - discountCents.
  discountCents Int           @default(0)
  date          DateTime      @default(now())
  studentId     Int
  student       Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  method        String?       @default("Espèces")
  // Set when the payment line belongs to a multi-child (grouped) payment.
  groupId       Int?
  group         PaymentGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// One transaction settling several children at once. Each child keeps its own
// Payment line (linked through groupId) so balances keep working per student.
model PaymentGroup {
  id            Int       @id @default(autoincrement())
  date          DateTime  @default(now())
  method        String?   @default("Espèces")
  subtotalCents Int
  discountCents Int
  totalCents    Int
  createdById   Int?
  payments      Payment[]
}

model Teacher {
  id             Int             @id @default(autoincrement())
  firstName      String
  lastName       String
  subject        String?
  email          String?         @unique
  phone          String?
  classId        Int?
  class          Class?          @relation(fields: [classId], references: [id])
  timetableSlots TimetableSlot[]
  lessons        Lesson[]
  createdAt      DateTime        @default(now())
}

model Attendance {
  id        Int     @id @default(autoincrement())
  date      String // "YYYY-MM-DD"
  // Half-day of the roll call: AM (courses starting before 13:00) or PM.
  // DAY marks the roll calls taken per day before half-days existed.
  period    String  @default("DAY")
  studentId Int
  classId   Int
  status    String  @default("PRESENT") // PRESENT, ABSENT, LATE
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class     Class   @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([date, period, studentId])
}

// ─── Scolarité : notes, compétences Juz Amma, bulletins ──────────────

// Subject graded with marks (Arabe, Éducation islamique...). The Juz Amma is
// NOT a subject: it is assessed with competencies (see SurahAssessment).
model Subject {
  id             Int             @id @default(autoincrement())
  name           String          @unique
  coefficient    Int             @default(1)
  evaluations    Evaluation[]
  timetableSlots TimetableSlot[]
  lessons        Lesson[]
  createdAt      DateTime        @default(now())
}

// A grading period (trimestre, semestre...). Its dates bound the attendance
// counted on the report card.
model Term {
  id            Int               @id @default(autoincrement())
  name          String            @unique
  startDate     String // "YYYY-MM-DD"
  endDate       String // "YYYY-MM-DD"
  evaluations   Evaluation[]
  surahLevels   SurahAssessment[]
  rubLevels     RubAssessment[]
  reportRemarks ReportRemark[]
  createdAt     DateTime          @default(now())
}

// One test given to a class (e.g. "Contrôle 1"), whose marks are entered together.
model Evaluation {
  id          Int      @id @default(autoincrement())
  title       String
  date        String // "YYYY-MM-DD"
  maxScore    Int      @default(20)
  coefficient Int      @default(1)
  classId     Int
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId   Int
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  termId      Int
  term        Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  grades      Grade[]
  createdAt   DateTime @default(now())

  @@index([classId, termId])
}

model Grade {
  id           Int        @id @default(autoincrement())
  // Mark in hundredths of a point (12.5/20 -> 1250), null when absent.
  scoreCents   Int?
  absent       Boolean    @default(false)
  evaluationId Int
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  studentId    Int
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, studentId])
}

// Competency level reached on one surah of the Juz Amma (surahs 78 to 114) for a term.
model SurahAssessment {
  id          Int     @id @default(autoincrement())
  surahNumber Int
  level       String // NOT_ACQUIRED, IN_PROGRESS, ACQUIRED, MASTERED
  studentId   Int
  student     Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId      Int
  term        Term    @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@unique([studentId, termId, surahNumber])
}

// Dar Al Coran (levels 5 to 11): competency level reached on one rob' (quarter)
// of a hizb (1 to 56) for a term. A hizb is acquired once its 4 rob' are.
model RubAssessment {
  id        Int     @id @default(autoincrement())
  hizb      Int // 1 to 56
  quarter   Int // 1 to 4
  level     String // NOT_ACQUIRED, IN_PROGRESS, ACQUIRED, MASTERED
  studentId Int
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    Int
  term      Term    @relation(fields: [termId], references: [id], onDelete: Restrict)

  @@unique([studentId, termId, hizb, quarter])
}

// General appreciation written on a student's report card for a term.
model ReportRemark {
  id        Int      @id @default(autoincrement())
  comment   String
  studentId Int
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  termId    Int
  term      Term     @relation(fields: [termId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt

  @@unique([studentId, termId])
}

// ─── Emplois du temps et cahier de textes ────────────────────────────

// Weekly recurring course of a class (e.g. every Saturday 09:00-10:30, Arabe).
// The activity is either a graded subject or a free label (Coran, Juz Amma...),
// since the Juz Amma is not a subject.
model TimetableSlot {
  id        Int      @id @default(autoincrement())
  dayOfWeek Int // 1 = lundi ... 7 = dimanche (ISO 8601)
  startTime String // "HH:MM"
  endTime   String // "HH:MM"
  label     String?
  room      String?
  classId   Int
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectId Int?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId Int?
  teacher   Teacher? @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  lessons   Lesson[]
  createdAt DateTime @default(now())

  @@index([classId, dayOfWeek])
  @@index([teacherId, dayOfWeek])
}

// One session actually held (cahier de textes): what was done and the work to
// do for the next session. Subject, label and times are copied from the slot so
// the log stays right when the timetable changes later in the year.
model Lesson {
  id              Int            @id @default(autoincrement())
  date            String // "YYYY-MM-DD"
  startTime       String? // "HH:MM"
  endTime         String? // "HH:MM"
  label           String?
  content         String?
  homework        String?
  homeworkDueDate String? // "YYYY-MM-DD", set whenever homework is
  classId         Int
  class           Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  slotId          Int?
  slot            TimetableSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  subjectId       Int?
  subject         Subject?       @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  teacherId       Int?
  teacher         Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([classId, date, slotId])
  @@index([classId, date])
  @@index([homeworkDueDate])
}

// ─── Pré-inscriptions en ligne ───────────────────────────────────────

// Settings of the online pre-registration form (a single row, id = 1).
model RegistrationSettings {
  id               Int      @id @default(1)
  isOpen           Boolean  @default(false)
  schoolYear       String   @default("2026-2027")
  minAge           Int      @default(4)
  ageReferenceDate String   @default("2026-10-31") // children must be minAge on this date
  contactEmail     String?
  helloAssoUrl     String?
  rulesText        String   @default("Règlement intérieur")
  updatedAt        DateTime @updatedAt
}

// File sent by a family from the public form. Nothing reaches the student list
// until the mosque validates it.
model PreRegistration {
  id            Int                       @id @default(autoincrement())
  reference     String                    @unique // PI-2026-0001
  status        String                    @default("NEW") // NEW, WAITLIST, VALIDATED, REFUSED
  schoolYear    String
  subtotalCents Int
  discountCents Int
  totalCents    Int
  rulesAccepted Boolean
  honorAttested Boolean
  emailStatus   String? // SENT, SIMULATED, FAILED
  emailText     String? // confirmation sent to the family, kept for the record
  adminNote     String?
  children      PreRegistrationChild[]
  guardians     PreRegistrationGuardian[]
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([status])
}

model PreRegistrationChild {
  id                Int             @id @default(autoincrement())
  preRegistrationId Int
  preRegistration   PreRegistration @relation(fields: [preRegistrationId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  birthDate         String // "YYYY-MM-DD"
  gender            String // "F" | "M"
  firstEnrollment   Boolean
  classId           Int?
  class             Class?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  feeCents          Int
  waitlisted        Boolean         @default(false) // the class was full when the file was sent
  medicalInfo       String?
  photoOptOut       Boolean         @default(false)
  canLeaveAlone     Boolean         @default(false)
  // Student created (or updated) when the file is validated.
  studentId         Int?
  student           Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([classId])
}

model PreRegistrationGuardian {
  id                Int             @id @default(autoincrement())
  preRegistrationId Int
  preRegistration   PreRegistration @relation(fields: [preRegistrationId], references: [id], onDelete: Cascade)
  relationship      String
  firstName         String
  lastName          String
  phone             String
  email             String
  address           String?
  profession        String?
  volunteer         Boolean         @default(false)
}
